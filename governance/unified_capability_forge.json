  "new_ideas": [
    {"id":"IDEA-01","name":"Capability DNA Hash","summary":"Fingerprint behavioral contracts, permissions, dependencies, triggers, and outputs so duplicate capabilities are detected even when names differ."},
    {"id":"IDEA-02","name":"Safety Budget Market","summary":"Allocate each autonomous run a spend, network, write, credential, and blast-radius budget; agents must trade scope for stronger privileges instead of receiving all privileges."},
    {"id":"IDEA-03","name":"Skill Greenhouse","summary":"Incubate candidate skills on synthetic tasks, then graduate only those that improve quality without increasing unsafe actions, cost, or context load."},
    {"id":"IDEA-04","name":"Negative Capability Registry","summary":"Record what each tool must never do, not merely what it can do, and use those negative contracts during routing."},
    {"id":"IDEA-05","name":"Simulation Twin","summary":"Create a deterministic shadow version of any automation that consumes copied inputs and emits predicted side effects before the real automation is eligible to run."},
    {"id":"IDEA-06","name":"Evidence Half-Life","summary":"Assign evidence an expiration model based on volatility so stale facts, tests, prices, APIs, and approvals automatically lose authority."},
    {"id":"IDEA-07","name":"Agent Immune System","summary":"Convert recurring failures, prompt injections, provenance gaps, and unsafe proposals into reusable detectors and regression tests."},
    {"id":"IDEA-08","name":"Context Branch Predictor","summary":"Predict the smallest next context bundle from task shape and recent execution traces, then measure incorrect preloads and missed retrievals."},
    {"id":"IDEA-09","name":"Reversibility Score","summary":"Score proposed actions by rollback completeness, data restoration, external side effects, and time-to-recover; route low-reversibility work to stricter approval."},
    {"id":"IDEA-10","name":"Human Attention Allocator","summary":"Rank review requests by expected harm avoided, uncertainty reduced, and decision leverage so the user sees the most valuable approvals first."}
  ]
