      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "MCP server for Kaseya Autotask PSA \u2014 companies, tickets, projects, time entries, and more.",
      "name": "io.github.gdstechnology/autotask-mcp",
      "packages": [
        {
          "environmentVariables": [
            {
