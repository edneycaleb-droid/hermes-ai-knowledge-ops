  "mcp_manifests": {
    "server.json": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "Persistent local AI memory. SQLite + FTS5 + vector search, knowledge graph. No cloud, no API keys.",
      "name": "io.github.studiomeyer-io/local-memory-mcp",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Custom path for the SQLite database file",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "MEMORY_DB_PATH"
            },
            {
              "description": "Disable the local embedding pipeline (forces FTS5-only search). Useful in restricted networks where the model can't be downloaded.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "MEMORY_EMBED_DISABLED"
            },
            {
              "description": "Override the embedding model id (defaults to Xenova/multilingual-e5-small).",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "MEMORY_EMBED_MODEL"
            },
            {
              "description": "Override the Transformers.js cache directory (defaults to the OS data dir).",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "MEMORY_EMBED_CACHE_DIR"
            }
          ],
          "identifier": "@studiomeyer/local-memory-mcp",
          "registryType": "npm",
          "transport": {
            "type": "stdio"
          },
          "version": "2.4.3"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/studiomeyer-io/local-memory-mcp"
      },
      "title": "Local Memory",
      "version": "2.4.3"
    }
