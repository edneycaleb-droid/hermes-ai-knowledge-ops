              "isSecret": true,
              "name": "ORCHESTRATOR_API_KEY"
            },
            {
              "default": "ollama",
              "description": "LLM provider for Cypher query generation (openai, anthropic, google, azure, cohere, ollama)",
              "name": "CYPHER_PROVIDER"
