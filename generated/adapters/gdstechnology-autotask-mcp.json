              "format": "string",
              "isRequired": true,
              "name": "AUTOTASK_USERNAME"
            },
            {
              "description": "Autotask API user secret",
              "format": "string",
              "isRequired": true,
              "isSecret": true,
              "name": "AUTOTASK_SECRET"
            },
            {
              "description": "Autotask API integration code (tracking identifier)",
              "format": "string",
              "isRequired": true,
              "isSecret": true,
              "name": "AUTOTASK_INTEGRATION_CODE"
            },
            {
              "description": "Autotask API zone URL \u2014 auto-detected per tenant if omitted",
              "format": "string",
              "isRequired": false,
              "name": "AUTOTASK_API_URL"
            },
            {
              "default": "stdio",
              "description": "Transport mode for the server. Set to 'stdio' for local CLI use; the image defaults to 'http' for gateway hosting.",
              "format": "string",
              "isRequired": false,
              "name": "MCP_TRANSPORT"
            },
            {
              "default": "env",
              "description": "Credential source: 'env' reads vars locally, 'gateway' expects header injection from the MCP Gateway.",
              "format": "string",
              "isRequired": false,
              "name": "AUTH_MODE"
            },
            {
              "default": "info",
              "description": "Log verbosity: debug, info, warn, error",
              "format": "string",
              "isRequired": false,
              "name": "LOG_LEVEL"
            }
          ],
          "identifier": "ghcr.io/gdstechnology/autotask-mcp:0.0.0",
          "registryType": "oci",
          "transport": {
            "type": "stdio"
          }
        }
