      "description": "Privacy-first, unofficial Fitbit MCP server for AI health, sleep, activity and heart-rate agents.",
      "name": "io.github.davidmosiah/fitbitmcp",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Fitbit OAuth client ID. Optional when configured with fitbit-mcp-server setup.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_CLIENT_ID"
            },
            {
              "description": "Fitbit OAuth client secret. Prefer fitbit-mcp-server setup so this secret is stored in ~/.fitbit-mcp/config.json instead of MCP client config.",
              "format": "string",
              "isRequired": false,
              "isSecret": true,
              "name": "FITBIT_CLIENT_SECRET"
            },
            {
              "description": "Redirect URI configured in the Fitbit Developer Dashboard. Optional when configured with fitbit-mcp-server setup.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_REDIRECT_URI"
            },
            {
              "description": "Optional local path for OAuth tokens. Defaults to ~/.fitbit-mcp/tokens.json.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_TOKEN_PATH"
            },
            {
              "description": "Optional payload mode: summary, structured, or raw. Defaults to structured. raw means full Fitbit API payloads, not continuous 24/7 raw sensor telemetry.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_PRIVACY_MODE"
            },
            {
              "description": "Optional SQLite cache toggle. Set to true or sqlite to enable.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_CACHE"
            },
            {
              "description": "Optional local SQLite cache path. Defaults to ~/.fitbit-mcp/cache.sqlite.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_CACHE_PATH"
            },
            {
              "description": "Set to true to bypass the in-memory HTTP response cache (60s TTL for GET only). POST/PUT/DELETE and 4xx/5xx responses are never cached regardless.",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "FITBIT_NO_CACHE"
            }
          ],
